# ==============================================================================
# GOSPEL AWARDS RDC — CONFIGURATION D'ENVIRONNEMENT (EXEMPLE)
# ==============================================================================
# Remplir ces variables dans vos paramètres de projet Vercel et Supabase.
# NE JAMAIS COMMITER DE VRAIES CLÉS SECRÈTES DANS LE DÉPÔT GIT.

# ------------------------------------------------------------------------------
# 1. BASE DE DONNÉES SUPABASE (POSTGRESQL)
# ------------------------------------------------------------------------------
# Chaîne de connexion Supabase Transaction Pooler (Port 6543) pour Prisma en production / Serverless
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Chaîne de connexion directe PostgreSQL Supabase (Port 5432) pour les migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE API & STORAGE
# ------------------------------------------------------------------------------
# URL publique de votre projet Supabase (Visible côté client)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Clé publique anonyme Supabase (Visible côté client, soumise aux règles RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Clé secrète de service Supabase (STRICTEMENT CÔTÉ SERVEUR - NE JAMAIS EXPOSER)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Nom du bucket Supabase Storage pour les médias d'artistes
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="artists-media"

# ------------------------------------------------------------------------------
# 3. AUTHENTIFICATION & SÉCURITÉ (NEXTAUTH / AUTH.JS)
# ------------------------------------------------------------------------------
# Secret de signature des sessions JWT (Générer avec: openssl rand -hex 32)
AUTH_SECRET="your-32-character-random-hex-secret-key-here"

# URL canonique de l'application
NEXTAUTH_URL="https://gospelawards.cd"

# Faire confiance au host proxy (nécessaire sur Vercel / environnements cloud)
AUTH_TRUST_HOST=true

# ------------------------------------------------------------------------------
# 4. PASSERELLES DE PAIEMENT MOBILE MONEY RDC (COLLECTE / ENCAISSEMENT)
# ------------------------------------------------------------------------------
# Secret de vérification des signatures Webhooks de paiement entrant
PAYMENT_WEBHOOK_SECRET="your-webhook-signature-verification-secret"

# ------------------------------------------------------------------------------
# 5. PASSERELLES DE RETRAIT MOBILE MONEY RDC (DÉCAISSEMENTS / PAYOUTS)
# ------------------------------------------------------------------------------
# M-Pesa RDC (Vodacom) - Laisser désactivé tant que les API officielles ne sont pas fournies
MPESA_ENABLED=false
MPESA_API_URL=""
MPESA_API_KEY=""
MPESA_API_SECRET=""
MPESA_MERCHANT_ID=""

# Orange Money RDC - Laisser désactivé tant que les API officielles ne sont pas fournies
ORANGE_MONEY_ENABLED=false
ORANGE_MONEY_API_URL=""
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_ID=""

